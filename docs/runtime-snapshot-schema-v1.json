{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CyberBASSLord-666/termux-mcp-edge/blob/main/docs/runtime-snapshot-schema-v1.json",
  "title": "Termux MCP Edge retained qualified-runtime snapshot v1",
  "description": "Closed identity record for the self-contained Docker image archive produced after native ARM64 validation. The record supports exact replay and makes no bit-for-bit rebuild or physical-device claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "snapshotVersion",
    "status",
    "failureCode",
    "releaseQualificationEligible",
    "repository",
    "commit",
    "androidRunId",
    "base",
    "runtimeImageId",
    "platform",
    "rootfsLayers",
    "packageLock",
    "installedPackages",
    "archive",
    "claimBoundary",
    "rebuildReproducibilityClaim"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "snapshotVersion": {"const": "1"},
    "status": {"const": "pass"},
    "failureCode": {"const": null},
    "releaseQualificationEligible": {"const": false},
    "repository": {"const": "CyberBASSLord-666/termux-mcp-edge"},
    "commit": {"$ref": "#/$defs/commit"},
    "androidRunId": {"$ref": "#/$defs/runId"},
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "digest", "imageId"],
      "properties": {
        "image": {"const": "termux/termux-docker:aarch64"},
        "digest": {"$ref": "#/$defs/ociDigest"},
        "imageId": {"$ref": "#/$defs/ociDigest"}
      }
    },
    "runtimeImageId": {"$ref": "#/$defs/ociDigest"},
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture"],
      "properties": {
        "os": {"const": "linux"},
        "architecture": {"const": "arm64"}
      }
    },
    "rootfsLayers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/ociDigest"}
    },
    "packageLock": {
      "allOf": [
        {"$ref": "#/$defs/fileRecord"},
        {
          "type": "object",
          "properties": {
            "fileName": {"const": "termux-runtime-package-lock-v1.json"}
          }
        }
      ]
    },
    "installedPackages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "count", "packages"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "packages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/installedPackage"}
        }
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "format", "compression", "sha256", "bytes"],
      "properties": {
        "fileName": {
          "const": "termux-qualified-runtime-image-v1.tar.gz"
        },
        "format": {"const": "docker-image-archive-v1"},
        "compression": {"const": "gzip-no-name"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1610612736
        }
      }
    },
    "claimBoundary": {"$ref": "#/$defs/claimBoundary"},
    "rebuildReproducibilityClaim": {"const": false}
  },
  "$defs": {
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ociDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "fileRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "sha256", "bytes"],
      "properties": {
        "fileName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        }
      }
    },
    "installedPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "version", "architecture"],
      "properties": {
        "package": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9+.-]{0,127}$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[!-~]+$"
        },
        "architecture": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
        }
      }
    },
    "claimBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "physicalDeviceObserved",
        "androidFrameworkObserved",
        "sustainedPhysicalSoak",
        "physicalCertification"
      ],
      "properties": {
        "physicalDeviceObserved": {"const": false},
        "androidFrameworkObserved": {"const": false},
        "sustainedPhysicalSoak": {"const": false},
        "physicalCertification": {"const": "not_run"}
      }
    }
  }
}
